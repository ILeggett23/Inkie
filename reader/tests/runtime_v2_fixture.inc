int witnessActor(){int fd=connect();control::Channel channel(fd,1,0,peer(fd));auto offer=receive(channel,2*S);need(offer.kind==bootstrap::Kind::WitnessOffer&&offer.identity.ownerPid==channel.peer().pid,"witness typed offer");need(offer.identity.invocation.data()==std::string(getenv("INVOCATION_ID")),"witness original invocation");need(witness::membership(offer.identity,getpid()),"actual bounded cgroup membership");if(scenario=="missing-witness")return 77;offer.kind=bootstrap::Kind::Receipt;offer.witnessPid=getpid();offer.drained=true;send(channel,offer);auto ack=receive(channel,2*S);need(ack.kind==bootstrap::Kind::WitnessAck&&ack.closure==offer.closure,"witness ack");mark("witness-done");return 0;}
int owner(){auto p=profile();runtime::Manager manager(p,session,"inkbound-stock-v2-test-"+session+".service");manager.retainOwnerAndStock();int listen=listener();const std::string helper=root+"/helper";auto command=[&](const char* role){return std::vector<std::string>{helper,role,root,session,scenario};};manager.create(runtime::Unit::Fuse,command("fuse"));manager.create(runtime::Unit::Reader,command("reader"),command("witness"));auto identity=manager.bind();auto fuse=manager.fuseBinding();auto start=clock(manager.connection());int child=-1,fuseFd=-1;
 for(unsigned n=0;n<2;++n){int fd=accept(listen,S);need(fd>=0,"bootstrap original endpoints");auto pid=peer(fd);if(pid==identity.mainPid)child=fd;else if(pid==fuse.mainPid)fuseFd=fd;else {close(fd);throw std::runtime_error("unmanaged bootstrap peer");}}
