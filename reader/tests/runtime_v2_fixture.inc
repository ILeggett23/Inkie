int originalLauncherFixtureMain(int argc,char** argv){try{need(argc==5,"role root session scenario");std::string role=argv[1];root=argv[2];session=argv[3];scenario=argv[4];need(recovery::hex32(session)&&(root.starts_with("/var/lib/inkbound-runtime-v2-test-")||root.starts_with("/home/root/inkbound-e2/A/rt-"))&&geteuid()==0,"inert fixture scope");if(role=="owner")return owner();if(role=="reader")return reader();if(role=="fuse")return fuseActor();if(role=="witness")return witnessActor();if(role=="stock"){mark("stock-start");for(;;)pause();}return 78;}catch(const std::exception& e){std::fprintf(stderr,"INERT_RUNTIME_FAIL %s\n",e.what());try{if(argc==5&&std::string(argv[1])=="witness"&&(scenario=="reference-loss"||scenario=="owner-loss")&&std::string(e.what())=="original socket connect")mark("expected-witness-unreachable",e.what());else mark("failure",e.what());}catch(...){}return 78;}}
