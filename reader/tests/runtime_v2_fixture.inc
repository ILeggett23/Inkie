 {control::Channel childBoot(dup(child),1,0,identity.mainPid),fuseBoot(dup(fuseFd),1,0,fuse.mainPid);send(childBoot,offer);send(fuseBoot,offer);auto ca=receive(childBoot,S),fa=receive(fuseBoot,S);auto ack=offer;ack.kind=bootstrap::Kind::Acknowledged;need(ca==ack&&fa==ack,"exact bootstrap acknowledgements");manager.stopStock();auto until=clock().monotonic+S;for(;;){auto s=manager.state(runtime::Unit::Stock);if(s.active=="inactive"&&!s.main&&!s.control&&!s.job)break;need(clock().monotonic<until,"stock stopped");usleep(1000);}auto permit=offer;permit.kind=bootstrap::Kind::Permit;send(childBoot,permit);}
 runtime::Owner runtime(manager,identity,p,7,start,child,1,fuseFd,2,fuse.mainPid);auto end=clock().monotonic+7*S;bool faultInjected=false;
 while(clock().monotonic<end&&!runtime.closed()){auto now=clock(manager.connection());Nonce entropy{};need(getrandom(entropy.data(),entropy.size(),0)==ssize_t(entropy.size()),"challenge nonce");runtime.poll(now,true,&entropy);if(!faultInjected&&std::filesystem::exists(root+"/reader-entered")&&(scenario=="reference-loss"||scenario=="owner-loss")){faultInjected=true;mark("fault-injected");if(scenario=="owner-loss")_exit(77);manager.disconnect();}usleep(3000);}
