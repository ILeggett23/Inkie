 if(scenario=="normal"){need(std::filesystem::exists(root+"/durable-complete")&&std::filesystem::exists(root+"/drain-complete")&&std::filesystem::exists(root+"/reader-exit"),"normal drainage precedes terminal");need(restored,"normal exact restoration");mark("result","NORMAL_DRAIN_RESTORED");}
