runtime::Profile profile(){runtime::Profile p;p.selection=runtime::Selection::Synthetic;p.qualification="synthetic-original-manager-runtime-v2";p.managerVersion=liveManagerVersion();p.powerRoutes="synthetic-awake-no-suspend";auto& t=p.timing;t.healthCadence=200000000;t.challengeLifetime=500000000;t.healthMaxAge=750000000;t.grantLifetime=5*S;t.drainLead=2*S;t.startupBudget=5*S;t.stopGrace=800000000;t.killGrace=800000000;t.proofWindow=3*S;t.sleepAllowance=8*S;t.clockSkew=10000000;t.workers=1;t.workerPolicies[0]={WorkerKind::DurablePrefix,8,2*S};p.fuse={S,S,250000000};p.readerCeiling=20*S;p.ownerCeiling=30*S;p.callBudget=100000000;p.startBudget=2*S;p.stopBudget=500000000;need(runtime::valid(p),"inert profile valid");return p;}
std::string socketPath(){return std::string(recovery::v2::Base)+"/"+session+"/runtime.sock";}
int listener(){std::filesystem::create_directories(std::string(recovery::v2::Base)+"/"+session);chmod(std::string(recovery::v2::Base).c_str(),0700);chmod((std::string(recovery::v2::Base)+"/"+session).c_str(),0700);int fd=socket(AF_UNIX,SOCK_SEQPACKET|SOCK_CLOEXEC,0);need(fd>=0,"listen socket");sockaddr_un a{};a.sun_family=AF_UNIX;auto path=socketPath();need(path.size()<sizeof a.sun_path,"socket path size");memcpy(a.sun_path,path.c_str(),path.size()+1);need(!bind(fd,reinterpret_cast<sockaddr*>(&a),sizeof a)&&!listen(fd,4),"private listener");return fd;}
int connect(){int fd=socket(AF_UNIX,SOCK_SEQPACKET|SOCK_CLOEXEC,0);need(fd>=0,"connect socket");sockaddr_un a{};a.sun_family=AF_UNIX;auto path=socketPath();memcpy(a.sun_path,path.c_str(),path.size()+1);need(!::connect(fd,reinterpret_cast<sockaddr*>(&a),sizeof a),"original socket connect");return fd;}
std::uint32_t peer(int fd){ucred c{};socklen_t size=sizeof c;need(!getsockopt(fd,SOL_SOCKET,SO_PEERCRED,&c,&size)&&size==sizeof c&&c.uid==0&&c.pid>1,"kernel root peer");return c.pid;}
int accept(int listener,Ns wait){pollfd f{listener,POLLIN,0};int result=poll(&f,1,int(wait/1000000));return result>0?accept4(listener,nullptr,nullptr,SOCK_CLOEXEC):-1;}
bootstrap::Packet receive(control::Channel& channel,Ns duration){auto until=clock().monotonic+duration;Wire wire;for(;;){auto read=channel.receive(wire);if(read==control::Read::Packet){auto p=bootstrap::decode(wire);need(p.has_value(),"bootstrap decode");return *p;}need(read==control::Read::Empty&&clock().monotonic<until,"bootstrap receive timeout");usleep(1000);}}
void send(control::Channel& channel,const bootstrap::Packet& p){Wire wire;need(bootstrap::encode(p,wire)&&channel.send(wire),"bootstrap send");}
bootstrap::Packet handshake(int fd,bool reader){auto p=profile();control::Channel channel(dup(fd),1,0,peer(fd));auto offer=receive(channel,5*S);need(offer.kind==bootstrap::Kind::Offer&&std::string(offer.profile.data())==p.qualification&&offer.identity.session.data()==session,"bootstrap selected offer");need(offer.identity.ownerPid==peer(fd),"bootstrap owner kernel identity");const char* invocation=getenv("INVOCATION_ID");need(invocation&&recovery::hex32(invocation),"PID1 process invocation");if(reader)need(offer.identity.mainPid==unsigned(getpid())&&offer.identity.invocation.data()==std::string(invocation),"actual reader identity");bootstrap::Packet ack=offer;ack.kind=bootstrap::Kind::Acknowledged;send(channel,ack);if(reader){bootstrap::Child gate;need(gate.offer(offer,channel.peer(),offer.identity,p.qualification,clock(offer.started.generation),p.timing),"reader offer accepted");auto permit=receive(channel,5*S);need(gate.permit(permit,channel.peer(),clock(offer.started.generation),p.timing),"reader original permit");}return offer;}
int reader(){int fd=connect();auto offer=handshake(fd,true);auto p=profile();std::atomic<bool> stop{},admitted{},closed{};progress::MainProgressChannel progress; // main thread owns all publications
 std::thread observer([&]{control::ChildControl child(offer.identity,offer.generation,p.timing,offer.started,fd,1,0,progress);while(!stop){auto generation=offer.started.generation;auto sample=[](void* context)noexcept{try{return clock(*static_cast<std::uint64_t*>(context));}catch(...){return ClockPair{};}};bool live=child.pollObserved({true,true,true,true},sample,&generation);admitted=child.admitted(clock(generation),{true,true,true,true});if(scenario=="stall"&&admitted)mark("background-progress");if(!live){closed=true;break;}usleep(2000);}});
 Health health;health.workerCount=1;progress::WorkLedger ledger(WorkerKind::DurablePrefix,8);std::thread writer;bool accepted=false;auto begin=clock();while(!closed&&clock().monotonic-begin.monotonic<10*S){auto now=clock(offer.started.generation);if(admitted&&!accepted){accepted=true;mark("reader-entered");auto token=ledger.accept(now);need(token.status==progress::Acceptance::Accepted,"writer accepted prefix");writer=std::thread([&,token]{usleep(250000);int file=open((root+"/durable-output").c_str(),O_CREAT|O_WRONLY|O_CLOEXEC,0600);need(file>=0&&write(file,"synthetic\n",10)==10&&!fsync(file),"accepted synthetic durable write");close(file);need(ledger.complete(token.token,progress::Outcome::DurableCommitted),"durable completion prefix");mark("worker-completed");});health.workers[0]=ledger.snapshot().health;health.workers[0]=ledger.snapshot().health;health.mainCompleted=health.captured=now;++health.mainSequence;need(progress.publish(health),"accepted write foreground boundary");if(scenario=="stall"){mark("foreground-stuck");for(;;)pause();}}
  if(scenario!="stall"||!accepted){health.workers[0]=ledger.snapshot().health;health.mainCompleted=health.captured=now;++health.mainSequence;need(progress.publish(health),"real foreground publication");}
  if(accepted&&(scenario=="normal"||scenario=="missing-witness"||scenario=="expired-proof")&&clock().monotonic-begin.monotonic>100000000){need(ledger.snapshot().health.backlog==1,"accepted write pending at quiescence");mark("drain-began");health.shutdown=true;health.workers[0]=ledger.snapshot().health;health.mainCompleted=health.captured=clock(offer.started.generation);++health.mainSequence;need(progress.publish(health),"close admission before drainage");auto until=clock().monotonic+350000000;while(clock().monotonic<until){health.workers[0]=ledger.snapshot().health;health.mainCompleted=health.captured=clock(offer.started.generation);++health.mainSequence;need(progress.publish(health),"drain foreground completion");usleep(5000);}if(writer.joinable())writer.join();auto finalWrite=ledger.snapshot();need(finalWrite.health.accepted==1&&finalWrite.health.completed==1&&!finalWrite.health.backlog,"no clean marker before accepted write durable prefix");need(std::filesystem::exists(root+"/fuse-closed"),"fuse entered inert closure before drainage finished");mark("durable-complete");mark("drain-complete");health.shutdown=true;health.workers[0]=ledger.snapshot().health;health.mainCompleted=health.captured=clock(offer.started.generation);++health.mainSequence;need(progress.publish(health),"shutdown foreground publication");break;}
  if(accepted&&scenario=="stall")mark("background-progress");usleep(10000);
 }
 stop=true;observer.join();if(writer.joinable())writer.join();mark("reader-exit");return 0;}
int fuseActor(){int fd=connect();need(sd_notify(0,"READY=1")>0,"fuse bounded inert Ready before reader ordering");auto offer=handshake(fd,false);auto p=profile();fuse::Binding binding;need(fuse::setUnitName(binding,offer.identity)&&text(binding.invocation,getenv("INVOCATION_ID")),"fuse actual invocation");binding.mainPid=getpid();binding.originalReference=offer.started.generation;fuse::OwnerChannel owner(fd,1,0,offer.identity.ownerPid);fuse::Evidence evidence{binding,offer.identity,true,true,true,true,true,true}; // verified owner bootstrap; power intentionally synthetic
 fuse::Lease lease(offer.identity,binding,offer.generation,p.timing,p.fuse,owner.peer(),0,offer.started,fuse::notifyRuntime,nullptr);
 auto generation=offer.started.generation;auto sampled=[](void* context)noexcept{try{return clock(*static_cast<std::uint64_t*>(context));}catch(...){return ClockPair{};}};while(owner.receiveObserved(lease,evidence,sampled,&generation))usleep(2000);
 // Normal closure never creates an earlier BindsTo kill than the existing
